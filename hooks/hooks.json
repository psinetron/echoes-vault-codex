{
  "description": "Expose concise EchoesVault availability and state at Codex session boundaries.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start.py\" --card",
            "timeout": 5,
            "additionalContextLimit": 2400
          }
        ]
      },
      {
        "matcher": "^compact$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start.py\"",
            "timeout": 5,
            "additionalContextLimit": 800
          }
        ]
      }
    ]
  }
}
